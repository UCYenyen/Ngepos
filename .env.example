# Supabase Configuration
SUPABASE_DB_URL=your_supabase_db_url_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Payment Gateway Configuration (Xendit)
# Platform account — used for subscription billing (paid to Ngepos).
XENDIT_SECRET_KEY=your_xendit_secret_key_here
XENDIT_CALLBACK_TOKEN=your_xendit_webhook_verification_token_here
p=your_xendit_public_key_here

# Encryption key for per-business Xendit secret keys (BYO keys), stored encrypted
# in the business_payment_credentials table. Must be 32 bytes as 64 hex chars.
# Generate with: openssl rand -hex 32
PAYMENT_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Notification Services Configuration
RESEND_API_KEY=your_resend_api_key_here
FONNTE_API_KEY=your_fonnte_api_key_here

# Scheduled jobs — Bearer token the subscription-renewals cron must send.
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# Public app URL — used by the subscription-renewals edge function for the
# Xendit invoice success/failure redirects (set this in the edge runtime env).
APP_URL=https://your-app-domain
